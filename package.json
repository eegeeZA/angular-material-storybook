{
  "name": "angular-material-storybook",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "storybook": "ng run angular-material-storybook:storybook",
    "build-storybook": "ng run angular-material-storybook:build-storybook",
    "test-storybook": "vitest --run --project=storybook",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.5.2",
    "@angular-devkit/architect": "^0.2202.0",
    "@angular-devkit/core": "^22.2.0",
    "@angular/animations": "^22.2.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/angular-vite": "^10.6.1",
    "@types/node": "^24",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "eslint-plugin-storybook": "^10.6.1",
    "jsdom": "^30.0.0",
    "playwright": "^1.64.0",
    "prettier": "^3.8.1",
    "storybook": "^10.6.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  }
}
